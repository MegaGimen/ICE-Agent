[Unit]
Description=ICE host daemon (perception, detection gate, orchestrator, safety gate, executor, ICE Gate)
# Starts last: after both models answer (ice-vllm/ice-kev block in ExecStartPost until ready). The daemon
# also re-checks the models itself before its first cycle and reports degraded/recovered to Slack.
After=network-online.target ice-vllm.service ice-kev.service ice-embed.service ice-mcp-proxy.service
Wants=ice-vllm.service ice-kev.service ice-embed.service ice-mcp-proxy.service
OnFailure=ice-status@%n.service

[Service]
User=root
WorkingDirectory=/home/dell/ICE
Environment=ICE_STATE_DIR=/var/lib/ice ICE_AGENT_USER=dell PYTHONUNBUFFERED=1
ExecStart=/home/dell/ice-envs/daemon-env/bin/python -m ice.daemon.main
Restart=on-failure
RestartSec=10
# Stop the orchestrator loop (SIGTERM) and any agent wake-up it started.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=ice.target
