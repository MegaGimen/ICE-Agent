[Unit]
Description=ICE knowledge/experience retrieval (bge-m3 on CPU, 127.0.0.1:8020)
After=ice-kev.service
OnFailure=ice-status@%n.service

[Service]
User=dell
WorkingDirectory=/home/dell/ICE
Environment=HF_HUB_CACHE=/home/dell/ice_models HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 CUDA_VISIBLE_DEVICES=
ExecStart=/home/dell/ice-envs/kev-env/bin/python -m ice.kb.embed_service
ExecStartPost=/home/dell/ICE/ice/serving/wait_ready.sh embed 300
TimeoutStartSec=400
Restart=on-failure
RestartSec=10

[Install]
WantedBy=ice.target
